# WebSocket URL for the FastAPI detection stream.
VITE_DETECTION_WS_URL=ws://localhost:8000/ws/detection

# Direct MP4 URL for the camera panel's demo video — same file OpenCV reads
# frames from and YAMNet extracts audio from on the backend (backend/demo/
# video.mp4), so what plays here is exactly what's being analysed.
VITE_DEMO_VIDEO_URL=http://localhost:8000/api/demo/video

# POSTed to when the user presses Start Demo or Restart, to reset the
# backend's video/audio playback position alongside the browser's.
VITE_DEMO_START_URL=http://localhost:8000/api/demo/start

# true  -> use the built-in simulated detection generator (no backend needed)
# false -> connect to VITE_DETECTION_WS_URL via WebSocket
VITE_USE_MOCK_DATA=false
