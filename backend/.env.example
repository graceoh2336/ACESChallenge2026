# Copy this file to .env and edit values as needed. .env is gitignored;
# this file documents what's available and its defaults.

# Camera input: "0" (or another integer) for a live webcam index, or a video
# file path (e.g. "demo/video.mp4") to loop a recorded clip through the
# OpenCV detector instead.
CAMERA_SOURCE=0

# If CAMERA_SOURCE fails to open and a demo video exists under backend/demo/,
# automatically switch to it instead of just logging that it's available.
CAMERA_AUTO_FALLBACK=false

# Verbose per-frame detection logging, saved debug frames under
# backend/debug_output/, and the /api/camera/debug-stream endpoint. Off by
# default — only turn on while investigating detector accuracy.
OPENCV_DEBUG=false

# How often (seconds) the detection pipeline broadcasts a new event.
BROADCAST_INTERVAL_SECONDS=1.0

# Probability that a given simulated tick detects a siren. Only used when
# USE_REAL_TENSORFLOW=false (or the real model fails to start and
# AUDIO_ALLOW_SIMULATION_FALLBACK=true).
AUDIO_DETECTION_PROBABILITY=0.55

# When true, audio detection runs real YAMNet/TensorFlow inference
# (backend/services/tensorflow_audio.py) instead of the random simulation.
USE_REAL_TENSORFLOW=true

# "mic" (or "live") for live microphone capture (Raspberry Pi deployment via
# sounddevice), or a WAV file path (e.g. "demo/siren.wav") to loop through
# the model instead. Resolved the same way as CAMERA_SOURCE.
AUDIO_SOURCE=demo/siren.wav

# YAMNet only accepts 16kHz mono audio; any other source sample rate is
# resampled to this before inference.
AUDIO_SAMPLE_RATE=16000

# Minimum YAMNet class score (0.0-1.0) before a window counts as a detection.
AUDIO_CONFIDENCE_THRESHOLD=0.65

# If the real TensorFlow audio service can't start (model failed to load, no
# working mic/file source), fall back to the random simulated service instead
# of just reporting "no detection". Off by default.
AUDIO_ALLOW_SIMULATION_FALLBACK=false

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
