# Copy this file to .env and edit values as needed. .env is gitignored;
# this file documents what's available and its defaults.

# Camera input: "0" (or another integer) for a live webcam index, or a video
# file path (e.g. "demo/video.mp4") to loop a recorded clip through the
# OpenCV detector instead. Defaults to the bundled demo clip, which also
# supplies YAMNet's audio track (see AUDIO_SOURCE below) — one file is the
# single source of truth for both video and audio in the demo.
CAMERA_SOURCE=demo/video.mp4

# If CAMERA_SOURCE fails to open and a demo video exists under backend/demo/,
# automatically switch to it instead of just logging that it's available.
CAMERA_AUTO_FALLBACK=false

# Verbose per-frame detection logging, saved debug frames under
# backend/debug_output/, and the /api/camera/debug-stream endpoint. Off by
# default — only turn on while investigating detector accuracy.
OPENCV_DEBUG=false

# How often (seconds) the detection pipeline broadcasts a new event.
BROADCAST_INTERVAL_SECONDS=1.0

# Probability that a given simulated tick detects a siren. Only used when
# USE_REAL_TENSORFLOW=false (or the real model fails to start and
# AUDIO_ALLOW_SIMULATION_FALLBACK=true).
AUDIO_DETECTION_PROBABILITY=0.55

# When true, audio detection runs real YAMNet/TensorFlow inference
# (backend/services/tensorflow_audio.py) instead of the random simulation.
USE_REAL_TENSORFLOW=true

# "video" (the default) extracts and loops the audio track baked into
# CAMERA_SOURCE's own video file — no separate WAV to maintain (extraction
# uses a bundled ffmpeg binary via imageio-ffmpeg, cached under
# backend/.cache/audio_extract/ after the first run). "mic" (or "live")
# switches to live microphone capture instead (Raspberry Pi deployment via
# sounddevice). Any other value is treated as a WAV/audio file path,
# resolved the same way as CAMERA_SOURCE.
AUDIO_SOURCE=video

# YAMNet only accepts 16kHz mono audio; any other source sample rate is
# resampled to this before inference.
AUDIO_SAMPLE_RATE=16000

# Minimum YAMNet class score (0.0-1.0) before a window counts as a detection.
AUDIO_CONFIDENCE_THRESHOLD=0.65

# If the real TensorFlow audio service can't start (model failed to load, no
# working mic/file source), fall back to the random simulated service instead
# of just reporting "no detection". Off by default.
AUDIO_ALLOW_SIMULATION_FALLBACK=false

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- YOLO vehicle-first vision pipeline -------------------------------
# When true, a vehicle must be YOLO-detected before flashing-blue-light
# evidence from lights.py is trusted (see backend/services/yolo_detector.py
# and backend/services/vision_fusion.py). Set to false to fall back to the
# pre-upgrade pipeline (raw lights.py output drives detection directly) —
# the safe rollback switch if YOLO can't be installed/run somewhere.
USE_YOLO=true

# Ultralytics model name. A bare name like "yolo11n.pt" auto-downloads into
# backend/.cache/yolo/ on first use. "n" (nano) is the smallest/fastest
# variant — the one intended for eventual Raspberry Pi 5 deployment.
YOLO_MODEL=yolo11n.pt

# Minimum YOLO detection confidence before a box counts as a vehicle. 0.25
# (lower than a first guess might suggest) because close-range night footage
# with heavy blue lens flare pushes even a real vehicle's YOLO confidence
# down to 0.15-0.45 — see backend/config.py's own comment for the measured
# numbers behind this default.
YOLO_CONFIDENCE_THRESHOLD=0.25

# How many times per second YOLO actually runs inference. Detections are
# cached between runs, so lights.py's own per-frame flash-timing analysis is
# unaffected by running YOLO less often than the video's native frame rate.
# 15 is tuned for a desktop demo (~25-27ms/inference on an M-series Mac);
# turn this down substantially on Raspberry Pi 5.
YOLO_INFERENCE_FPS=15

# Comma-separated COCO classes treated as "vehicle". Anything else YOLO
# detects (person, traffic light, stop sign, ...) is ignored outright.
YOLO_VEHICLE_CLASSES=car,truck,bus,motorcycle

# Fractional padding added around a YOLO vehicle box (relative to its own
# width/height) before testing whether a flashing-light candidate falls
# inside it — catches roof/grille lightbars that sit just outside YOLO's
# tight box without accepting evidence that's genuinely off the vehicle.
YOLO_ROI_PADDING=0.15

# How many YOLO inference intervals a cached vehicle detection stays valid
# for before being treated as stale (vehicle presumed gone).
YOLO_STALE_INTERVALS=4

# Rolling window (in main detection-loop frames) used to judge whether
# vehicle+light association is a stable, repeated pattern rather than
# one-frame noise, and the fraction of that window required before the
# combined visual state is allowed to reach "confirmed" rather than the
# weaker "possible".
YOLO_ASSOCIATION_WINDOW=15
YOLO_ASSOCIATION_RATIO_REQUIRED=0.45
