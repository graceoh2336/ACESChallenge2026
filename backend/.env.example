# Copy this file to .env and edit values as needed. .env is gitignored;
# this file documents what's available and its defaults.

# Camera input: "0" (or another integer) for a live webcam index, or a video
# file path (e.g. "demo/video.mp4") to loop a recorded clip through the
# OpenCV detector instead.
CAMERA_SOURCE=0

# If CAMERA_SOURCE fails to open and a demo video exists under backend/demo/,
# automatically switch to it instead of just logging that it's available.
CAMERA_AUTO_FALLBACK=false

# Verbose per-frame detection logging, saved debug frames under
# backend/debug_output/, and the /api/camera/debug-stream endpoint. Off by
# default — only turn on while investigating detector accuracy.
OPENCV_DEBUG=false

# How often (seconds) the detection pipeline broadcasts a new event.
BROADCAST_INTERVAL_SECONDS=1.0

# Probability that a given simulated tick detects a siren (audio is still
# simulated pending the real TensorFlow model).
AUDIO_DETECTION_PROBABILITY=0.55

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
